# Copy values into .env for application runtime.
# Keep env.txt for local editing if you do not want to open .env directly.
WORKFOLDER=./workfolder
# Optional destination for finished videos and matching Chinese .srt subtitles.
# Leave empty to keep only workfolder copies. Example: D:/YouDubExports  or  ./exports
OUTPUT_DIR=
MODEL_CACHE_DIR=./data/modelscope
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=
YOUDUB_AUTH_PASSWORD_HASH=
YOUDUB_AUTH_SESSION_TTL_SECONDS=604800
YOUDUB_AUTH_COOKIE_SECURE=false
YOUDUB_AUTH_COOKIE_SAMESITE=strict
DEVICE=cuda
DEMUCS_DEVICE=
WHISPER_DEVICE=
FFMPEG_PATH=
FFPROBE_PATH=
# merge_video encoder: auto (default), copy, x264, nvenc, qsv, amf
MERGE_VIDEO_ENCODER=auto
MERGE_VIDEO_CRF=23
MERGE_VIDEO_NVENC_PRESET=p4
LOCAL_UPLOAD_MAX_BYTES=4294967296
LOCAL_SUBTITLE_MAX_BYTES=20971520
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSLATE_CONCURRENCY=8
YTDLP_PROXY_PORT=
FUNASR_MODEL=iic/SenseVoiceSmall
FUNASR_VAD_MODEL=fsmn-vad
VOXCPM_MODEL=OpenBMB/VoxCPM2
VOXCPM_MODEL_DIR=
# Volcengine / Doubao unidirectional streaming TTS (HTTP V3)
# Docs: https://docs.volcengine.com/docs/6561/2528925?lang=zh
# Prefer API key auth (X-Api-Key). Legacy auth uses APP_ID + ACCESS_KEY.
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_KEY=
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_SPEAKER=zh_female_shuangkuaisisi_moon_bigtts
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_SAMPLE_RATE=24000
VOLCENGINE_TTS_SPEECH_RATE=0
VOLCENGINE_TTS_CONCURRENCY=4
VOLCENGINE_TTS_UID=youdub-webui
# Azure Speech TTS REST
# Docs: https://learn.microsoft.com/azure/ai-services/speech-service/rest-text-to-speech
AZURE_TTS_SUBSCRIPTION_KEY=
AZURE_TTS_REGION=eastasia
AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural
AZURE_TTS_LOCALE=zh-CN
AZURE_TTS_ENDPOINT=
AZURE_TTS_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
AZURE_TTS_SPEECH_RATE=0
AZURE_TTS_CONCURRENCY=4
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
